# Verbinding met de standalone PostgreSQL-server (gewone TCP-verbinding via
# de `postgres` npm-package).
# Lokaal:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motrac_ds_checkbox
# Productie: de verbindingsstring uit het Databases-paneel van control.motrac.app,
# geplakt in het Environment-paneel van de backend-applicatie — niet hier.
# Die server is primary+standby: een komma-gescheiden hostlijst plus
# `?target_session_attrs=read-write`. db.js zoekt daarin zelf de schrijfbare
# host op (bij het opstarten én opnieuw na een failover).
#DATABASE_URL=postgres://user:pass@db-host-a:5432,db-host-b:5432/motrac_ds_checkbox?target_session_attrs=read-write

# Poort waarop deze Express-server lokaal luistert. Elke app-backend heeft een
# eigen vaste poort zodat ze lokaal gelijktijdig kunnen draaien:
# motrac-beheer=8787, motrac-bmwt-stickers=8788, motrac-restlast=8789,
# ai-innovation-hub=8790, motrac-mymotrac=8791, mit-control-tower=8792,
# mit-capaciteitsplanningtool=8793, mit-rental-configurator=8794,
# mit-erp=8795, mit-salessupport=8796, mit-handleiding=8797,
# **MIT_DS_checkbox=8798**. In productie zet het platform PORT zelf.
PORT=8798

# Toegestane CORS-origins voor de eigen frontend van deze app (komma-
# gescheiden bij meerdere, bv. lokaal + productie).
FRONTEND_ORIGIN=http://localhost:5173
#FRONTEND_ORIGIN=http://localhost:5173,https://<frontend-id>.dev.motrac.app

# Origin van de Motrac-beheer-backend — gewone uitgaande HTTP-call, gebruikt
# voor token-introspectie (/verify) en het doorzetten van feedback.
# Lokaal, tegen een lokaal draaiende Motrac-beheer-backend (poort 8787):
MOTRAC_BEHEER_URL=http://localhost:8787
# Productie: dezelfde origin als VITE_MOTRAC_AUTH_URL van de frontend.
#MOTRAC_BEHEER_URL=https://9x24841z85.dev.motrac.app

# API-key van deze app bij Motrac-beheer, voor de server-to-server
# /verify-call (X-Api-Key-header). Komt uit AppManager zodra de app daar
# geregistreerd is. Zonder deze env-var valt de backend terug op de
# config-tabel in de eigen database (key 'MOTRAC_VERIFY_KEY').
MOTRAC_VERIFY_KEY=

# --- Deployen vanaf de CLI (IT Dashboard) ---------------------------------
# Persoonlijk deploy token, aan te maken op de applicatiepagina van
# https://control.motrac.app onder "Deploy tokens" -> "Genereer mijn token".
# Zet de echte waarde in backend/.env (staat in .gitignore), NOOIT hier.
# Deployen daarna, vanuit backend/:
#   set -a; source .env; set +a
#   node ../scripts/dashboard-deploy.mjs --message "wat er verandert"
DASHBOARD_DEPLOY_TOKEN=
