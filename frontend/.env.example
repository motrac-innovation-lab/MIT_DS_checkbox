# Backend van deze app (Node/Express, zie ../backend). De SPA praat er via
# een absolute URL mee (VITE_API_BASE_URL), niet via een dev-proxy.
# Lokaal (backend draait via `npm run dev` in ../backend, standaard poort 8798):
VITE_API_BASE_URL=http://localhost:8798
# Productie: de echte URL van de gedeployde backend (invullen zodra de app een
# deploy-target heeft — zie DEPLOY.md). In CI komt deze waarde uit de
# repository-variabele VITE_API_BASE_URL.
#VITE_API_BASE_URL=https://<backend-id>.dev.motrac.app

# Motrac Toegangsbeheer — centrale login. VITE_MOTRAC_AUTH_URL is de origin van
# de beheer-backend, zonder pad — de client hangt hier zelf /api/v1/<slug>
# achter. Zonder .env-override gebruikt src/lib/motracAuth.ts de
# productie-Motrac-beheer van de fleet; zet lokaal http://localhost:8787 om
# tegen een lokale Motrac-beheer-instantie te testen.
#VITE_MOTRAC_AUTH_URL=http://localhost:8787

# PLACEHOLDER — de app is nog niet geregistreerd in Motrac Toegangsbeheer
# (AppManager -> nieuwe app aanmaken). Zet daarna de toegekende slug hier, in
# de repository-variabele VITE_MOTRAC_AUTH_SLUG (CI) én in APP_SLUG in
# backend/server.js — die drie moeten gelijk zijn.
VITE_MOTRAC_AUTH_SLUG=mit-ds-checkbox

# Silent SSO (automatisch inloggen vanuit Motrac-beheer). Standaard aan: bij het
# laden zonder geldig token stuurt de app door naar de SSO-handoff van beheer.
# Zet op "off" voor lokale UI-ontwikkeling zodat je het loginscherm houdt.
#VITE_SSO_AUTOSTART=off
